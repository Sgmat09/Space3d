// space3d/engine_afterburner: the boost of an engine (looping), placed like `ENGINE_EXHAUST`
// (behind the hull, flame along the emitter's +Z) and tinted with the engine color (linear,
// largest component about 2): a long white-hot plume with a blue-white core, three shock
// diamonds riding the nozzle, a glowing ribbon trail along the ship's path, and heat sparks.
// Drive `rate_scale` with the boost (0..1.5): the plume keeps its density and grows longer and
// brighter with it. Layer it over `ENGINE_EXHAUST` while boosting.
ParticleEffect(
    name: "space3d/engine_afterburner",
    looping: true,
    // Ambient: yields the pool to combat effects (stops at 75 % of the budget).
    priority: Low,
    ribbons: [
        (
            name: "trail",
            offset: (0.0, 0.0, 4.0),
            min_distance: 2.5,
            max_interval: 0.05,
            max_points: 96,
            lifetime: 0.55,
            width: 5.0,
            width_over_life: Keys([(0.0, 0.7), (0.2, 1.0), (1.0, 0.1)]),
            color_over_life: (keys: [
                (0.0, (0.9, 0.95, 1.1, 1.0)),
                (0.4, (0.35, 0.38, 0.5, 1.0)),
                (1.0, (0.04, 0.05, 0.08, 0.0)),
            ]),
            profile: (core: 0.25, hardness: 0.0),
            uv: Tile(length: 20.0),
            scroll: 2.0,
            noise: 0.3,
        ),
    ],
    layers: [
        (
            name: "plume",
            spawn: (rate: 260.0, rate_per_distance: 0.4, max_rate_scale: 1.5),
            shape: Cone(angle: 0.1, radius: 0.8),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.08,
            inherit_velocity: 0.2,
            lifetime: (0.3, 0.42),
            speed: (80.0, 100.0),
            drag: 2.2,
            size: (5.0, 7.5),
            size_over_life: Linear(0.7, 1.8),
            throttle: (rate: 0.25, speed: 0.7, size: 0.3, intensity: 0.5),
            color_over_life: (keys: [
                (0.0, (2.2, 2.3, 2.6, 1.0)),
                (0.25, (0.9, 0.95, 1.2, 0.9)),
                (1.0, (0.06, 0.07, 0.12, 0.0)),
            ]),
            render: (shape: Glow(core: 0.0, hardness: 0.0)),
        ),
        (
            name: "core",
            space: Local,
            spawn: (rate: 60.0, max_rate_scale: 1.5),
            offset: (0.0, 0.0, 3.0),
            lifetime: 0.08,
            size: 6.0,
            throttle: (rate: 0.0, size: 0.4, intensity: 0.6),
            color_over_life: (keys: [(0.0, (5.0, 5.2, 6.0, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.9, hardness: 0.0)),
        ),
        (
            name: "diamond_1",
            space: Local,
            spawn: (rate: 60.0, max_rate_scale: 1.5),
            offset: (0.0, 0.0, 7.0),
            lifetime: 0.07,
            size: 4.2,
            throttle: (rate: 0.0, size: 0.5, intensity: 1.0),
            color_over_life: (keys: [(0.0, (4.0, 4.3, 5.5, 1.0))]),
            alpha_over_life: Preset(InOut),
            flicker: Some((amplitude: 0.35, frequency: 17.0)),
            render: (shape: Glow(core: 0.7, hardness: 0.0)),
        ),
        (
            name: "diamond_2",
            space: Local,
            spawn: (rate: 60.0, max_rate_scale: 1.5),
            offset: (0.0, 0.0, 11.5),
            lifetime: 0.07,
            size: 3.4,
            throttle: (rate: 0.0, size: 0.5, intensity: 1.2),
            color_over_life: (keys: [(0.0, (2.8, 3.0, 4.2, 1.0))]),
            alpha_over_life: Preset(InOut),
            flicker: Some((amplitude: 0.4, frequency: 19.0)),
            render: (shape: Glow(core: 0.6, hardness: 0.0)),
        ),
        (
            name: "diamond_3",
            space: Local,
            spawn: (rate: 60.0, max_rate_scale: 1.5),
            offset: (0.0, 0.0, 15.5),
            lifetime: 0.07,
            size: 2.6,
            throttle: (rate: 0.0, size: 0.5, intensity: 1.5),
            color_over_life: (keys: [(0.0, (1.8, 2.0, 3.0, 1.0))]),
            alpha_over_life: Preset(InOut),
            flicker: Some((amplitude: 0.45, frequency: 21.0)),
            render: (shape: Glow(core: 0.5, hardness: 0.0)),
        ),
        (
            name: "sparks",
            spawn: (rate: 30.0, max_rate_scale: 1.5),
            shape: Cone(angle: 0.25, radius: 0.6),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.25,
            inherit_velocity: 0.2,
            lifetime: (0.2, 0.45),
            speed: (110.0, 170.0),
            drag: 1.5,
            size: (1.0, 1.5),
            color_over_life: (keys: [(0.0, (6.0, 6.3, 7.0, 1.0)), (1.0, (1.0, 1.1, 1.5, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (
                shape: Streak(core: 0.6, taper: 1.0),
                facing: VelocityStretched(scale: 0.03, min: 1.0, max: 8.0),
            ),
        ),
        (
            // Strong heat haze along the boosted plume (post distortion), behind its hot core.
            name: "heat",
            spawn: (rate: 30.0, max_rate_scale: 1.5),
            offset: (0.0, 0.0, 6.0),
            shape: Cone(angle: 0.1, radius: 0.8),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.08,
            inherit_velocity: 0.2,
            lifetime: (0.4, 0.5),
            speed: (60.0, 76.0),
            drag: 2.2,
            size: (10.0, 14.0),
            size_over_life: Linear(0.9, 2.2),
            throttle: (rate: 0.25, speed: 0.7, size: 0.3, intensity: 0.5),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.0, hardness: 0.0), target: Distortion(strength: 0.006)),
        ),
    ],
)
