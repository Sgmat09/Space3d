// space3d/missile_trail: a missile's exhaust (looping; `EffectSpawn::at(Vec3::ZERO)
// .follow(missile)` with the missile facing −Z, the flame at +Z): a white-hot flame and a short
// glowing wake riding the missile, sparks, and a smoke ribbon laid along its path that widens,
// breaks up and fades over 1.1 s, with soft puffs of the same smoke scattered along it (random
// spacing and offsets, fading in: volume, never knots on a string). When the missile despawns the
// smoke drains and the effect finishes. The flame is fire-colored (untinted); `tint` colors the
// wake only. For missiles at up to about 900 units/s (a ribbon point per 6 units).
ParticleEffect(
    name: "space3d/missile_trail",
    looping: true,
    ribbons: [
        (
            name: "smoke",
            offset: (0.0, 0.0, 2.0),
            min_distance: 6.0,
            max_interval: 0.1,
            max_points: 160,
            lifetime: 1.1,
            width: 7.0,
            width_over_life: Keys([(0.0, 0.5), (0.3, 1.5), (1.0, 3.0)]),
            color_over_life: (keys: [
                (0.0, (0.6, 0.5, 0.42, 0.85)),
                (0.2, (0.36, 0.35, 0.35, 0.7)),
                (0.7, (0.24, 0.24, 0.26, 0.35)),
                (1.0, (0.18, 0.18, 0.2, 0.0)),
            ]),
            profile: (core: 0.0, hardness: 0.0),
            uv: Tile(length: 14.0),
            noise: 0.7,
            blend: Alpha,
            tinted: false,
            order: -1,
        ),
        (
            name: "wake",
            offset: (0.0, 0.0, 1.5),
            min_distance: 3.0,
            max_points: 32,
            lifetime: 0.16,
            width: 4.0,
            width_over_life: Linear(1.0, 0.2),
            color_over_life: (keys: [(0.0, (3.0, 2.2, 1.4, 1.0)), (1.0, (1.2, 0.35, 0.08, 0.0))]),
            profile: (core: 0.4, hardness: 0.0),
        ),
    ],
    layers: [
        (
            name: "flame",
            space: Local,
            offset: (0.0, 0.0, 2.2),
            spawn: (rate: 60.0),
            lifetime: 0.07,
            size: 7.0,
            color_over_life: (keys: [(0.0, (6.0, 3.8, 1.6, 1.0))]),
            alpha_over_life: Preset(InOut),
            tinted: false,
            render: (shape: Glow(core: 0.7, hardness: 0.0)),
        ),
        (
            name: "sparks",
            spawn: (rate: 24.0),
            offset: (0.0, 0.0, 2.2),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.5,
            inherit_velocity: 0.3,
            lifetime: (0.15, 0.35),
            speed: (60.0, 140.0),
            drag: 3.0,
            size: (0.8, 1.4),
            color_over_life: (keys: [(0.0, (8.0, 5.0, 2.0, 1.0)), (1.0, (2.0, 0.5, 0.08, 1.0))]),
            alpha_over_life: Preset(Linear),
            tinted: false,
            render: (
                shape: Streak(core: 0.5, taper: 1.0),
                facing: VelocityStretched(scale: 0.03, min: 1.0, max: 8.0),
            ),
        ),
        (
            // Scattered along the path (a box 30 units long around the laying point breaks the
            // per-distance spacing), wider than the young ribbon, in the ribbon's own grey and
            // fading in, so they merge into it as volume.
            name: "puffs",
            // A fixed ring: at a missile's 600–900 units/s the oldest puffs make way for new
            // ones (the ribbon carries the smoke), instead of the ring growing with the speed.
            spawn: (rate_per_distance: 0.05),
            capacity: Some(40),
            offset: (0.0, 0.0, 12.0),
            shape: Box(half_extents: (3.0, 1.0, 15.0)),
            direction: Random,
            flatten: 0.5,
            lifetime: (0.6, 1.0),
            speed: (3.0, 10.0),
            drag: 1.0,
            size: (18.0, 28.0),
            size_over_life: Linear(0.7, 2.0),
            rotation: (0.0, 6.283),
            angular_velocity: (-0.5, 0.5),
            // Premultiplied: the light it adds is its color whatever its coverage, so the grey
            // is the ribbon's (0.36 at 70 % opacity) × the puff's coverage: overlapping puffs
            // thicken the smoke instead of stacking into bright knots.
            color_over_life: (keys: [(0.0, (0.05, 0.048, 0.048, 1.0)), (1.0, (0.03, 0.03, 0.034, 1.0))]),
            alpha_over_life: Preset(InOut),
            coverage: (0.12, 0.2),
            coverage_over_life: Preset(InOut),
            tinted: false,
            // Crossing trails interleave their puffs in depth order.
            render: (shape: Smoke(breakup: 0.5, hot_core: 0.0), blend: Premultiplied, order: -2, sort: ByDistance),
        ),
    ],
)
