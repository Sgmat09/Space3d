// space3d/repair_beam: a repair (or healing, shield-transfer) beam from the emitter to its
// `ParticleBeam` end (looping, like `LASER_BEAM`: `BeamEnd::Entity(target)`): a soft green
// stream flowing toward the target (scrolling noise), a thin bright filament that wavers
// around it (jitter), round glows at both ends and a gentle pulse. Tinted (default green: tint
// white keeps it; any color recolors it).
ParticleEffect(
    name: "space3d/repair_beam",
    looping: true,
    beams: [
        (
            name: "stream",
            width: 10.0,
            length: 300.0,
            color: (keys: [(0.0, (0.25, 1.4, 0.55, 1.0)), (1.0, (0.35, 1.8, 0.8, 1.0))]),
            segments: 12,
            profile: (core: 0.0, hardness: 0.0),
            uv: Tile(length: 24.0),
            scroll: 2.5,
            noise: 0.6,
            flicker: Some((amplitude: 0.2, frequency: 3.0)),
            start_glow: 1.5,
            end_glow: 2.2,
        ),
        (
            name: "filament",
            width: 1.4,
            length: 300.0,
            color: (keys: [(0.0, (1.2, 4.5, 2.0, 1.0))]),
            segments: 24,
            jitter: 4.0,
            jitter_hz: 12.0,
            profile: (core: 0.5, hardness: 0.0),
            end_glow: 3.0,
        ),
    ],
    layers: [
        (
            name: "source",
            space: Local,
            spawn: (rate: 60.0),
            lifetime: 0.1,
            size: 8.0,
            color_over_life: (keys: [(0.0, (0.8, 3.0, 1.4, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.4, hardness: 0.0)),
        ),
    ],
)
