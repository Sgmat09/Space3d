// space3d/shield_ripple: a shield hit (the game's `shield_hit`) around the emitter: an arc on
// the emitter's XZ plane brightest toward its −Z (spawn at the shield center with
// `EffectSpawn::facing(-bolt_direction)` and `.follow(ship)`; scale = shield radius / 20), a
// faint full ring, a flash on the shield surface and a few tangent streaks. Saturated blue
// (low red and green) so it stays a shield's color through AgX instead of turning pastel.
ParticleEffect(
    name: "space3d/shield_ripple",
    duration: 0.05,
    layers: [
        (
            name: "arc",
            lod: false,
            space: Local,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.32,
            size: 49.0,
            size_over_life: Linear(1.0, 1.12),
            rotation: 1.5708,
            color_over_life: (keys: [(0.0, (0.12, 0.55, 2.8, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Ring(thickness: 0.09, focus: 4.0, fill: 0.08), facing: EmitterPlane),
        ),
        (
            name: "bubble",
            lod: false,
            space: Local,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.25,
            size: 52.0,
            size_over_life: Linear(1.0, 1.1),
            color_over_life: (keys: [(0.0, (0.03, 0.18, 0.8, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Ring(thickness: 0.04, focus: 0.0, fill: 0.0), facing: EmitterPlane),
        ),
        (
            name: "flash",
            lod: false,
            space: Local,
            offset: (0.0, 0.0, -23.4),
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.16,
            size: 20.0,
            size_over_life: Linear(1.0, 2.4),
            color_over_life: (keys: [(0.0, (0.12, 0.55, 2.8, 1.0))]),
            alpha_over_life: Preset(Flash),
            render: (shape: Glow(core: 0.7, hardness: 0.0)),
        ),
        (
            name: "streaks",
            offset: (0.0, 0.0, -23.4),
            spawn: (bursts: [(count: 5)]),
            direction: Fixed((0.0, 0.0, -1.0)),
            spread: 0.6,
            flatten: 1.0,
            lifetime: (0.15, 0.3),
            speed: (120.0, 260.0),
            drag: 5.0,
            size: 1.2,
            color_over_life: (keys: [(0.0, (0.12, 0.55, 2.8, 1.0))]),
            alpha_over_life: Preset(Linear),
            render: (
                shape: Streak(core: 0.4, taper: 1.0),
                facing: VelocityStretched(scale: 0.04, min: 1.0, max: 16.0),
            ),
        ),
    ],
)
