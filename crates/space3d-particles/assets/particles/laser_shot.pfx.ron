// space3d/laser_shot: a hitscan laser shot (one-shot): `spawn_effect(builtin::LASER_SHOT,
// EffectSpawn::at(muzzle).beam_to(BeamEnd::World(hit)).tint(color))` draws the beam from the
// muzzle to the hit for 0.12 s, fading as it thins, with a muzzle flash and a hot glow on the
// hit (pair it with `HIT_SPARK` there). Tinted like `LASER_BEAM` (the core stays white-hot);
// despawns itself.
ParticleEffect(
    name: "space3d/laser_shot",
    duration: 0.12,
    beams: [
        (
            name: "glow",
            width: 4.0,
            length: 400.0,
            color: (keys: [(0.0, (2.4, 2.4, 2.4, 1.0))]),
            fade: Keys([(0.0, 1.0), (0.3, 0.8), (1.0, 0.0)]),
            segments: 4,
            profile: (core: 0.0, hardness: 0.0),
            end_glow: 2.8,
        ),
        (
            name: "core",
            width: 1.4,
            length: 400.0,
            color: (keys: [(0.0, (4.0, 4.0, 4.0, 1.0))]),
            tinted: false,
            fade: Preset(Out),
            segments: 4,
            profile: (core: 0.7, hardness: 0.0),
            end_glow: 2.2,
        ),
    ],
    layers: [
        (
            name: "muzzle",
            lod: false,
            space: Local,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.1,
            size: 9.0,
            size_over_life: Linear(1.0, 1.6),
            color_over_life: (keys: [(0.0, (6.0, 6.0, 6.0, 1.0))]),
            alpha_over_life: Preset(Flash),
            render: (shape: Glow(core: 0.6, hardness: 0.0)),
        ),
    ],
)
