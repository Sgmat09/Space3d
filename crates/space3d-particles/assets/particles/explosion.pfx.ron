// space3d/explosion: flash, afterglow, smoke, fireball billows, hot core, sparks, embers and
// two shockwave rings (the SpaceCorps2027 `fx::particles::explosion` recipe as data), plus a
// shockwave that bends the space behind it (post distortion).
// Scale 1 ≈ a 40-unit hull; intensities are linear HDR, authored for post (AgX + bloom): the
// flash, core and sparks reach white and bloom, embers are born white-hot and cool to orange
// and red within a fifth of their life, the fireball burns from white-hot to saturated orange,
// the shockwave is a thin hot front, and the smoke keeps a faint cool light so it reads against
// space once the fire is out. A light flash lights nearby hulls.
ParticleEffect(
    name: "space3d/explosion",
    duration: 0.1,
    priority: High,
    // The fire lights the hulls around it (a `PointLight` for 0.6 s, from above the blast).
    light: Some((
        duration: 0.6,
        color: (1.0, 0.55, 0.22),
        peak: 4000.0,
        range: 220.0,
        intensity: Preset(Flash),
        offset: (0.0, 18.0, 0.0),
    )),
    layers: [
        (
            name: "flash",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.18,
            size: 60.0,
            size_over_life: Linear(1.0, 2.7),
            color_over_life: (keys: [(0.0, (5.0, 4.2, 3.2, 1.0))]),
            alpha_over_life: Preset(Flash),
            render: (shape: Glow(core: 0.9, hardness: 0.0)),
        ),
        (
            name: "afterglow",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.55,
            size: 120.0,
            size_over_life: Linear(1.0, 2.3),
            color_over_life: (keys: [(0.0, (0.9, 0.26, 0.05, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Glow(core: 0.0, hardness: 0.0)),
        ),
        (
            name: "smoke",
            spawn: (bursts: [(count: 7)]),
            shape: Sphere(radius: 26.0, inner: 0.3),
            direction: Shape,
            flatten: 0.7,
            particle_delay: (0.25, 0.5),
            lifetime: (2.4, 3.6),
            speed: (20.0, 55.0),
            speed_scale_exponent: 0.5,
            drag: 0.8,
            size: (36.0, 56.0),
            size_over_life: Linear(0.7, 2.0),
            rotation: (0.0, 6.283),
            angular_velocity: (-0.3, 0.3),
            color_over_life: (keys: [(0.0, (0.07, 0.024, 0.008, 1.0)), (0.5, (0.014, 0.015, 0.024, 1.0)), (1.0, (0.01, 0.011, 0.018, 1.0))]),
            alpha_over_life: Preset(Linger),
            coverage: (0.7, 0.9),
            coverage_over_life: Preset(Linger),
            tinted: false,
            // The dark smoke lingers and drifts into other blasts' smoke: sorted per particle, so
            // overlapping clouds interleave in depth order (the fireball keeps its age order: the
            // freshest, hottest billows on top).
            render: (shape: Smoke(breakup: 0.9, hot_core: 0.0), blend: Premultiplied, soft_distance: 8.0, order: -1, sort: ByDistance),
        ),
        (
            name: "fireball",
            spawn: (bursts: [(count: 14)]),
            shape: Sphere(radius: 16.0, inner: 0.0),
            flatten: 0.5,
            particle_delay: (0.0, 0.06),
            lifetime: (1.4, 2.1),
            speed: (40.0, 130.0),
            speed_scale_exponent: 0.5,
            drag: 2.6,
            size: (30.0, 50.0),
            size_over_life: Linear(0.6, 2.2),
            rotation: (0.0, 6.283),
            angular_velocity: (-0.6, 0.6),
            color_over_life: (keys: [
                (0.0, (4.5, 1.35, 0.18, 1.0)),
                (0.3, (1.6, 0.22, 0.03, 1.0)),
                (1.0, (0.12, 0.012, 0.002, 1.0)),
            ]),
            start_color: (a: (0.85, 0.85, 0.85, 1.0), b: (1.15, 1.15, 1.15, 1.0)),
            alpha_over_life: Preset(Burn),
            coverage: (0.5, 0.65),
            coverage_over_life: Preset(Hold),
            render: (shape: Smoke(breakup: 0.75, hot_core: 0.35), blend: Premultiplied, soft_distance: 6.0),
        ),
        (
            name: "core",
            spawn: (bursts: [(count: 6)]),
            shape: Sphere(radius: 8.0, inner: 0.0),
            flatten: 0.5,
            lifetime: (0.25, 0.45),
            speed: (20.0, 70.0),
            speed_scale_exponent: 0.5,
            drag: 3.0,
            size: (20.0, 32.0),
            size_over_life: Linear(0.8, 1.7),
            color_over_life: (keys: [(0.0, (3.5, 1.5, 0.35, 1.0)), (1.0, (0.8, 0.1, 0.012, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Glow(core: 0.3, hardness: 0.0)),
        ),
        (
            name: "sparks",
            spawn: (bursts: [(count: (26, 34))]),
            direction: Random,
            flatten: 0.75,
            lifetime: (0.35, 0.9),
            speed: (220.0, 750.0),
            speed_scale_exponent: 0.5,
            drag: 2.4,
            size: (1.8, 3.2),
            color_over_life: (keys: [(0.0, (15.0, 10.0, 4.2, 1.0)), (1.0, (4.8, 1.05, 0.12, 1.0))]),
            alpha_over_life: Preset(Linear),
            render: (
                shape: Streak(core: 0.6, taper: 1.0),
                facing: VelocityStretched(scale: 0.045, min: 1.0, max: 24.0),
            ),
        ),
        (
            name: "embers",
            spawn: (bursts: [(count: 16)]),
            direction: Random,
            flatten: 0.6,
            lifetime: (0.9, 2.0),
            speed: (60.0, 220.0),
            speed_scale_exponent: 0.5,
            drag: 1.2,
            size: (4.0, 7.0),
            size_over_life: Linear(1.0, 0.3),
            color_over_life: (keys: [
                (0.0, (9.0, 5.5, 2.0, 1.0)),
                (0.2, (4.2, 1.5, 0.25, 1.0)),
                (0.6, (2.2, 0.5, 0.05, 1.0)),
                (1.0, (0.9, 0.14, 0.012, 1.0)),
            ]),
            alpha_over_life: Preset(Linear),
            flicker: Some((amplitude: 0.35, frequency: 5.0)),
            render: (shape: Glow(core: 0.2, hardness: 0.0)),
        ),
        (
            name: "shockwave",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.3,
            size: 24.0,
            size_over_life: Keys([(0.0, 1.0), (0.25, 7.3), (0.5, 12.5), (0.75, 15.6), (1.0, 16.7)]),
            color_over_life: (keys: [(0.0, (2.5, 1.2, 0.4, 1.0)), (1.0, (0.3, 0.06, 0.01, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Ring(thickness: 0.025, focus: 0.0, fill: 0.0), facing: Plane(normal: (0.0, 1.0, 0.0))),
        ),
        (
            name: "shockwave_wide",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            particle_delay: 0.04,
            lifetime: 0.6,
            size: 40.0,
            size_over_life: Keys([(0.0, 1.0), (0.25, 3.9), (0.5, 5.9), (0.75, 7.1), (1.0, 7.5)]),
            color_over_life: (keys: [(0.0, (0.14, 0.045, 0.012, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Ring(thickness: 0.06, focus: 0.0, fill: 0.03), facing: Plane(normal: (0.0, 1.0, 0.0))),
        ),
        (
            // The blast front bends the space behind it (drawn into the post distortion buffer
            // by cameras with `PostProcess`; nothing without): the image under the expanding
            // band is pushed outward, trailing the wide shockwave ring.
            name: "shockwave_distortion",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            particle_delay: 0.04,
            lifetime: 0.45,
            size: 46.0,
            size_over_life: Keys([(0.0, 1.0), (0.33, 3.9), (0.67, 5.9), (1.0, 7.1)]),
            alpha_over_life: Preset(Out),
            render: (
                shape: Ring(thickness: 0.14, focus: 0.0, fill: 0.0),
                facing: Plane(normal: (0.0, 1.0, 0.0)),
                target: Distortion(strength: 0.03),
            ),
        ),
    ],
)
