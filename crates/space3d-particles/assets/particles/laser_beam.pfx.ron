// space3d/laser_beam: a continuous laser from the emitter to its `ParticleBeam` end (mining,
// tractor, a held weapon): put the emitter on the gun (`Transform` + `Parent(ship)` or
// `EffectSpawn::follow`) and give it `ParticleBeam { end: BeamEnd::Entity(target), .. }` (or
// `EffectSpawn::beam_to`); without one it reaches 400 units along the gun's −Z. Looping: stop
// or despawn it when the laser stops. Tinted by the emitter (a saturated tier color such as
// `(1, 0, 0)`): a wide soft glow of the tint around a white-hot core (untinted), energy flowing
// along it (scrolling noise), a slight flicker, a round glow where it hits and a muzzle glow.
// End it on the hit point (`BeamEnd::World`) rather than inside a hull, whose depth hides the
// end glow. Authored for HDR + bloom (the core reaches white, the glow blooms).
ParticleEffect(
    name: "space3d/laser_beam",
    looping: true,
    beams: [
        (
            name: "glow",
            width: 8.0,
            length: 400.0,
            color: (keys: [(0.0, (2.6, 2.6, 2.6, 1.0))]),
            segments: 8,
            profile: (core: 0.0, hardness: 0.0),
            uv: Tile(length: 30.0),
            scroll: 3.0,
            noise: 0.35,
            flicker: Some((amplitude: 0.12, frequency: 23.0)),
            start_glow: 1.6,
            end_glow: 2.4,
        ),
        (
            name: "core",
            width: 1.6,
            length: 400.0,
            color: (keys: [(0.0, (3.5, 3.5, 3.5, 1.0))]),
            segments: 8,
            profile: (core: 0.6, hardness: 0.0),
            flicker: Some((amplitude: 0.08, frequency: 31.0)),
            end_glow: 2.5,
            tinted: false,
        ),
    ],
    layers: [
        (
            name: "muzzle",
            space: Local,
            spawn: (rate: 60.0),
            lifetime: 0.08,
            size: 7.0,
            color_over_life: (keys: [(0.0, (5.0, 5.0, 5.0, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.5, hardness: 0.0)),
        ),
    ],
)
