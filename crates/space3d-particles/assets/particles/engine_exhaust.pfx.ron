// space3d/engine_exhaust: looping engine plume along the emitter's +Z (a ship faces −Z: put the
// emitter behind the hull as a child, `Transform::from_xyz(0.0, 0.0, 3.2)` + `Parent(ship)`).
// Drive `ParticleEmitter::rate_scale` with the throttle (0..2). Particles inherit part of the
// ship's velocity; emission is spread over each tick's motion, so fast ships never clump. The
// plume is soft glows without cores or rims, dense enough to read as one flame; only the nozzle
// has a hot core. Its colors are near-neutral (white-hot, faintly cool): the flame takes its hue
// from the tint, so any faction color works (`.tint(color)`: linear RGB whose largest component
// is about 2, like the game's engine colors — `(0.3, 0.9, 2.0)` an ion-blue drive, `(2.0, 0.9,
// 0.2)` orange); untinted it burns a dimmer white. Every plume particle lives most of the life window, so the tail thins out evenly
// instead of breaking into beads at small on-screen sizes.
ParticleEffect(
    name: "space3d/engine_exhaust",
    looping: true,
    layers: [
        (
            name: "plume",
            spawn: (rate: 180.0, rate_per_distance: 0.4, max_rate_scale: 2.0),
            shape: Cone(angle: 0.12, radius: 0.6),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.12,
            inherit_velocity: 0.25,
            lifetime: (0.34, 0.45),
            speed: (40.0, 52.0),
            drag: 2.0,
            size: (4.0, 6.0),
            size_over_life: Linear(0.8, 2.0),
            color_over_life: (keys: [
                (0.0, (1.6, 1.65, 1.95, 1.0)),
                (0.3, (0.6, 0.62, 0.75, 0.8)),
                (1.0, (0.07, 0.07, 0.1, 0.0)),
            ]),
            render: (shape: Glow(core: 0.0, hardness: 0.0)),
        ),
        (
            name: "sparks",
            spawn: (rate: 12.0, max_rate_scale: 2.0),
            shape: Cone(angle: 0.3, radius: 0.4),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.3,
            inherit_velocity: 0.25,
            lifetime: (0.2, 0.5),
            speed: (50.0, 90.0),
            drag: 1.5,
            size: (0.8, 1.2),
            color_over_life: (keys: [(0.0, (5.0, 5.2, 6.0, 1.0)), (1.0, (0.8, 0.85, 1.1, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (
                shape: Streak(core: 0.6, taper: 1.0),
                facing: VelocityStretched(scale: 0.03, min: 1.0, max: 6.0),
            ),
        ),
        (
            name: "nozzle",
            space: Local,
            spawn: (rate: 60.0, max_rate_scale: 2.0),
            lifetime: 0.1,
            size: 5.0,
            color_over_life: (keys: [(0.0, (1.5, 1.6, 1.9, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.8, hardness: 0.0)),
        ),
    ],
)
