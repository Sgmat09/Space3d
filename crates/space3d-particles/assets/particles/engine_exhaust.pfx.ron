// space3d/engine_exhaust: looping engine plume along the emitter's +Z (a ship faces −Z: put the
// emitter behind the hull as a child, `Transform::from_xyz(0.0, 0.0, 3.2)` + `Parent(ship)`).
// Drive `ParticleEmitter::rate_scale` with the throttle (0..2). Particles inherit part of the
// ship's velocity; emission is spread over each tick's motion, so fast ships never clump. The
// plume is laid mostly per unit flown (`rate_per_distance` 1.0: a glow every unit, each 4–6
// units wide, so it cannot bead at any frame rate or speed) plus a time rate for the plume of a
// ship at rest; its rings are sized for a cruise of 75 units/s and grow with the ship's speed
// (`Spawn::max_speed`: a faster ship restarts the loop with bigger rings). The
// plume is soft glows without cores or rims, dense enough to read as one flame at any throttle:
// it thins only slowly with the throttle and gets shorter, narrower and dimmer instead
// (`throttle`), so partial throttle never breaks it into puffs; only the nozzle has a hot core. Its colors are near-neutral (white-hot, faintly cool): the flame takes its hue
// from the tint, so any faction color works (`.tint(color)`: linear RGB whose largest component
// is about 2, like the game's engine colors — `(0.3, 0.9, 2.0)` an ion-blue drive, `(2.0, 0.9,
// 0.2)` orange); untinted it burns a dimmer white. Every plume particle lives most of the life window, so the tail thins out evenly
// instead of breaking into beads at small on-screen sizes.
ParticleEffect(
    name: "space3d/engine_exhaust",
    looping: true,
    // Ambient: yields the pool to combat effects (stops at 75 % of the budget).
    priority: Low,
    layers: [
        (
            name: "plume",
            spawn: (rate: 160.0, rate_per_distance: 1.0, max_rate_scale: 2.0, max_speed: 75.0),
            shape: Cone(angle: 0.12, radius: 0.6),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.12,
            inherit_velocity: 0.25,
            lifetime: (0.34, 0.45),
            speed: (40.0, 52.0),
            drag: 2.0,
            size: (4.0, 6.0),
            size_over_life: Linear(0.8, 2.0),
            throttle: (rate: 0.25, speed: 0.6, size: 0.3, intensity: 0.5),
            color_over_life: (keys: [
                (0.0, (1.6, 1.65, 1.95, 1.0)),
                (0.3, (0.6, 0.62, 0.75, 0.8)),
                (1.0, (0.07, 0.07, 0.1, 0.0)),
            ]),
            render: (shape: Glow(core: 0.0, hardness: 0.0)),
        ),
        (
            name: "sparks",
            spawn: (rate: 12.0, max_rate_scale: 2.0),
            shape: Cone(angle: 0.3, radius: 0.4),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.3,
            inherit_velocity: 0.25,
            lifetime: (0.2, 0.5),
            speed: (50.0, 90.0),
            drag: 1.5,
            size: (0.8, 1.2),
            color_over_life: (keys: [(0.0, (5.0, 5.2, 6.0, 1.0)), (1.0, (0.8, 0.85, 1.1, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (
                shape: Streak(core: 0.6, taper: 1.0),
                facing: VelocityStretched(scale: 0.03, min: 1.0, max: 6.0),
            ),
        ),
        (
            name: "nozzle",
            space: Local,
            spawn: (rate: 60.0, max_rate_scale: 2.0),
            lifetime: 0.1,
            size: 5.0,
            throttle: (rate: 0.0, size: 0.4, intensity: 0.6),
            color_over_life: (keys: [(0.0, (1.5, 1.6, 1.9, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.8, hardness: 0.0)),
        ),
        (
            // Heat haze in the flame's wake (drawn into the post distortion buffer by cameras
            // with `PostProcess`; nothing without): stars and hulls behind the plume shimmer.
            // It starts behind the hot core and bends at most a tenth of its own size (the
            // distortion cap), so the flame it rides on shimmers instead of kinking. Follows
            // the throttle like the plume.
            name: "heat",
            spawn: (rate: 24.0, max_rate_scale: 2.0),
            offset: (0.0, 0.0, 5.0),
            shape: Cone(angle: 0.12, radius: 0.6),
            direction: Fixed((0.0, 0.0, 1.0)),
            spread: 0.1,
            inherit_velocity: 0.25,
            lifetime: (0.4, 0.5),
            speed: (22.0, 30.0),
            drag: 2.0,
            size: (8.0, 11.0),
            size_over_life: Linear(0.9, 2.2),
            throttle: (rate: 0.25, speed: 0.6, size: 0.3, intensity: 0.5),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.0, hardness: 0.0), target: Distortion(strength: 0.004)),
        ),
    ],
)
