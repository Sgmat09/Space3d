// space3d/warp_in: arriving through a portal (the game's `warp(arriving: true)`): a spinning
// vortex collapsing inward, streaks rushing to the center, then a flash (a white-hot core in a
// saturated blue halo, authored for HDR + bloom) and two expanding rings when the ship appears
// (0.25 s in). Sized for the reference view (1.4 px per unit, a 40-unit hull at scale 1): the
// vortex starts about four hulls across and the rings end about three to four; scale it with
// `EffectSpawn::scale` for bigger ships or closer cameras.
ParticleEffect(
    name: "space3d/warp_in",
    duration: 0.05,
    layers: [
        (
            name: "vortex",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.9,
            size: 150.0,
            size_over_life: Linear(1.0, 0.12),
            angular_velocity: 14.0,
            color_over_life: (keys: [(0.0, (0.25, 0.7, 2.8, 1.0))]),
            alpha_over_life: Preset(InOut),
            // Never clamped by `ParticleSettings::max_screen_size` (the layer's own cap is 4
            // view heights), so the collapse keeps its timing (and the streaks start inside it)
            // at any zoom.
            render: (
                shape: Vortex(arms: 4.0, twist: 1.4),
                facing: Plane(normal: (0.0, 1.0, 0.0)),
                max_screen_size: 4.0,
            ),
        ),
        (
            name: "streaks",
            spawn: (bursts: [(count: 22)]),
            shape: Sphere(radius: 90.0, inner: 0.55),
            direction: Inward,
            flatten: 1.0,
            particle_delay: (0.0, 0.1),
            lifetime: (0.25, 0.4),
            speed: (170.0, 250.0),
            size: 2.6,
            color_over_life: (keys: [(0.0, (2.0, 2.0, 2.0, 1.0))]),
            start_color: (a: (0.25, 0.7, 2.8, 1.0), b: (1.0, 0.3, 2.6, 1.0)),
            alpha_over_life: Preset(InOut),
            render: (
                shape: Streak(core: 0.5, taper: 1.0),
                facing: VelocityStretched(scale: 0.06, min: 1.0, max: 24.0),
            ),
        ),
        (
            // A saturated blue halo (dim enough that AgX keeps its hue)…
            name: "flash",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            particle_delay: 0.25,
            lifetime: 0.5,
            size: 130.0,
            size_over_life: Linear(1.0, 0.29),
            color_over_life: (keys: [(0.0, (0.3, 0.75, 3.0, 1.0))]),
            alpha_over_life: Preset(Flash),
            render: (shape: Glow(core: 0.0, hardness: 0.0), max_screen_size: 4.0),
        ),
        (
            // …around a short white-hot core that reaches white and blooms (HDR).
            name: "core",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            particle_delay: 0.25,
            lifetime: 0.3,
            size: 56.0,
            size_over_life: Linear(1.0, 0.4),
            color_over_life: (keys: [(0.0, (10.0, 11.0, 16.0, 1.0))]),
            alpha_over_life: Preset(Flash),
            render: (shape: Glow(core: 3.0, hardness: 0.0), max_screen_size: 4.0),
        ),
        (
            name: "ring",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            particle_delay: 0.25,
            lifetime: 0.6,
            size: 16.0,
            size_over_life: Keys([(0.0, 1.0), (0.25, 3.8), (0.5, 6.2), (0.75, 7.6), (1.0, 8.0)]),
            color_over_life: (keys: [(0.0, (0.25, 0.7, 2.8, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Ring(thickness: 0.12, focus: 0.0, fill: 0.05), facing: Plane(normal: (0.0, 1.0, 0.0))),
        ),
        (
            name: "ring_alt",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            particle_delay: 0.33,
            lifetime: 0.6,
            size: 16.0,
            size_over_life: Keys([(0.0, 1.0), (0.25, 4.6), (0.5, 7.7), (0.75, 9.4), (1.0, 10.0)]),
            color_over_life: (keys: [(0.0, (1.0, 0.3, 2.6, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Ring(thickness: 0.12, focus: 0.0, fill: 0.05), facing: Plane(normal: (0.0, 1.0, 0.0))),
        ),
        (
            // The vortex twists the space around the portal (drawn into the post distortion
            // buffer by cameras with `PostProcess`; nothing without)…
            name: "vortex_distortion",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.9,
            size: 150.0,
            size_over_life: Linear(1.0, 0.12),
            angular_velocity: 14.0,
            alpha_over_life: Preset(InOut),
            render: (
                shape: Vortex(arms: 4.0, twist: 1.4),
                facing: Plane(normal: (0.0, 1.0, 0.0)),
                max_screen_size: 4.0,
                target: Distortion(strength: 0.025),
            ),
        ),
        (
            // …and its shockwave pushes the image outward behind the rings.
            name: "shockwave",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            particle_delay: 0.25,
            lifetime: 0.6,
            size: 20.0,
            size_over_life: Keys([(0.0, 1.0), (0.25, 3.8), (0.5, 6.2), (0.75, 7.6), (1.0, 8.0)]),
            alpha_over_life: Preset(Out),
            render: (
                shape: Ring(thickness: 0.14, focus: 0.0, fill: 0.0),
                facing: Plane(normal: (0.0, 1.0, 0.0)),
                max_screen_size: 4.0,
                target: Distortion(strength: 0.03),
            ),
        ),
    ],
)
