// space3d/hit_spark: a hull hit (the game's `impact`): a flash, sparks thrown back along the
// emitter's −Z (spawn with `EffectSpawn::facing(-bolt_direction)`), a small ring on the
// emitter's plane and two puffs of smoke. Tinted by the emitter (the laser's color). The flash
// sits 2 units off the hull toward the shooter and, like the ring, fades into the hull
// (`soft_distance`) instead of being cut by it; authored for HDR + bloom.
ParticleEffect(
    name: "space3d/hit_spark",
    duration: 0.05,
    layers: [
        (
            name: "flash",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.14,
            offset: (0.0, 0.0, -2.0),
            size: 20.0,
            size_over_life: Linear(1.0, 2.6),
            color_over_life: (keys: [(0.0, (4.0, 3.5, 3.0, 1.0))]),
            alpha_over_life: Preset(Flash),
            render: (shape: Glow(core: 0.9, hardness: 0.0), soft_distance: 5.0),
        ),
        (
            name: "sparks",
            spawn: (bursts: [(count: (8, 12))]),
            direction: Fixed((0.0, 0.0, -1.0)),
            spread: 0.7,
            flatten: 0.6,
            lifetime: (0.18, 0.4),
            speed: (180.0, 480.0),
            speed_scale_exponent: 0.5,
            drag: 5.0,
            size: 1.6,
            color_over_life: (keys: [(0.0, (12.0, 9.0, 6.0, 1.0)), (1.0, (3.0, 1.6, 0.8, 1.0))]),
            alpha_over_life: Preset(Linear),
            render: (
                shape: Streak(core: 0.5, taper: 1.0),
                facing: VelocityStretched(scale: 0.035, min: 1.0, max: 16.0),
            ),
        ),
        (
            name: "ring",
            lod: false,
            spawn: (bursts: [(count: 1)]),
            lifetime: 0.2,
            size: 8.0,
            size_over_life: Linear(1.0, 3.8),
            color_over_life: (keys: [(0.0, (2.5, 2.0, 1.6, 1.0))]),
            alpha_over_life: Preset(Out),
            render: (shape: Ring(thickness: 0.15, focus: 0.0, fill: 0.0), facing: EmitterPlane, soft_distance: 5.0),
        ),
        (
            name: "smoke",
            spawn: (bursts: [(count: 2)]),
            direction: Random,
            flatten: 0.5,
            lifetime: (0.5, 0.9),
            speed: (20.0, 40.0),
            drag: 1.5,
            size: 10.0,
            size_over_life: Linear(1.0, 3.2),
            rotation: (0.0, 6.283),
            color_over_life: (keys: [(0.0, (0.01, 0.0084, 0.008, 1.0))]),
            alpha_over_life: Preset(InOut),
            coverage: 0.35,
            coverage_over_life: Preset(InOut),
            tinted: false,
            render: (shape: Smoke(breakup: 0.5, hot_core: 0.0), blend: Premultiplied, order: -1),
        ),
    ],
)
