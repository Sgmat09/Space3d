// space3d/laser_trail: the glowing wake of a bolt (spawn with `EffectSpawn::at(muzzle)
// .follow(bolt).tint(tier_color)`): a head glow riding the bolt and a dense trail of glows laid
// along its path (emitted per unit of distance, spread over each tick's motion, so it stays
// continuous at 3200 units/s). When the bolt despawns the trail drains and the effect finishes.
ParticleEffect(
    name: "space3d/laser_trail",
    looping: true,
    layers: [
        (
            name: "trail",
            spawn: (rate_per_distance: 0.5),
            lifetime: 0.15,
            size: 3.2,
            color_over_life: (keys: [(0.0, (1.6, 1.6, 1.6, 1.0)), (1.0, (0.2, 0.2, 0.2, 1.0))]),
            alpha_over_life: Preset(Out),
            capacity: Some(512),
            render: (shape: Glow(core: 0.4, hardness: 0.3)),
        ),
        (
            name: "head",
            space: Local,
            spawn: (rate: 60.0),
            lifetime: 0.05,
            size: 8.0,
            color_over_life: (keys: [(0.0, (2.5, 2.5, 2.5, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.8, hardness: 0.0)),
        ),
    ],
)
