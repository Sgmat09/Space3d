// space3d/laser_trail: the glowing wake of a bolt (spawn with `EffectSpawn::at(muzzle)
// .follow(bolt).tint(tier_color)`): a white-hot head riding the bolt and a ribbon of glow laid
// along its path (a point per tick, or per 8 units at low speed), 0.15 s long, from the bolt's
// render position back along its path whatever stage moves it and at any speed. Authored for
// HDR + bloom: the trail starts at 9× the tint and the head at 8×, so a saturated tint (a pure
// primary like the game's red `(1, 0, 0)`) keeps its hue in the beam and blooms, while its
// white core makes the hot center line; the trail cools, thins and fades toward its tail. When
// the bolt despawns the trail drains and the effect finishes.
ParticleEffect(
    name: "space3d/laser_trail",
    looping: true,
    ribbons: [
        (
            name: "trail",
            min_distance: 8.0,
            max_points: 64,
            lifetime: 0.15,
            width: 4.5,
            width_over_life: Linear(1.0, 0.6),
            color_over_life: (keys: [
                (0.0, (9.0, 9.0, 9.0, 1.0)),
                (0.4, (4.4, 4.4, 4.4, 0.8)),
                (1.0, (1.0, 1.0, 1.0, 0.0)),
            ]),
            profile: (core: 0.45, hardness: 0.0),
        ),
    ],
    layers: [
        (
            name: "head",
            space: Local,
            spawn: (rate: 60.0),
            lifetime: 0.05,
            size: 6.0,
            color_over_life: (keys: [(0.0, (8.0, 8.0, 8.0, 1.0))]),
            alpha_over_life: Preset(InOut),
            render: (shape: Glow(core: 0.6, hardness: 0.0)),
        ),
    ],
)
