# The game packaged for phones. Android loads a `cdylib`, iOS (Xcode) links a `staticlib`;
# keeping them in this separate crate means desktop and web builds of the main package never
# link those extra library types.
#
#   space3d build --target android     # cargo ndk build -p {{name}}-mobile --lib, then Gradle (../android/)
#   space3d build --target ios --sim   # cargo build -p {{name}}-mobile --lib --target aarch64-apple-ios-sim
#
# Android packaging (application id, name, SDK levels, orientation, permissions, icons,
# signing) lives in the Gradle project ../android/ — see ../android/README.md.
[package]
name = "{{name}}-mobile"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
name = "{{crate_name}}_mobile"
path = "src/lib.rs"
crate-type = ["cdylib", "staticlib"]

[dependencies]
# The game package (`{{name}}`), used from Rust as `{{crate_name}}`.
{{crate_name}} = { package = "{{name}}", path = ".." }
space3d = { {{space3d_dep}}, features = ["stories"] }
