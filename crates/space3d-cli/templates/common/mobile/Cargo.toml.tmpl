# The game packaged for phones. Android (`cargo apk`) loads a `cdylib`, iOS (Xcode) links a
# `staticlib`; keeping them in this separate crate means desktop and web builds of the main
# package never link those extra library types.
#
#   space3d build --target android     # = cargo apk build -p {{name}}-mobile --lib
#   space3d build --target ios --sim   # = cargo build -p {{name}}-mobile --lib --target aarch64-apple-ios-sim
[package]
name = "{{name}}-mobile"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
name = "{{crate_name}}_mobile"
path = "src/lib.rs"
crate-type = ["cdylib", "staticlib"]

[dependencies]
# The game package (`{{name}}`), used from Rust as `{{crate_name}}`.
{{crate_name}} = { package = "{{name}}", path = ".." }
space3d = { {{space3d_dep}}, features = ["stories"] }

# ---- Android (cargo-apk) --------------------------------------------------------------------
# https://github.com/rust-mobile/cargo-apk — see ../android/README.md
[package.metadata.android]
package = "{{android_package}}"
apk_name = "{{name}}"
build_targets = ["aarch64-linux-android"]
# Copied into the APK; load them with the asset server as usual.
assets = "../assets"

[package.metadata.android.sdk]
min_sdk_version = 28
target_sdk_version = 35

[package.metadata.android.application]
label = "{{title}}"

[package.metadata.android.application.activity]
orientation = "landscape"
config_changes = "orientation|screenSize|keyboardHidden"

# Vulkan (wgpu's Android backend) is required.
[[package.metadata.android.uses_feature]]
name = "android.hardware.vulkan.level"
required = true
version = 1

[[package.metadata.android.uses_permission]]
name = "android.permission.INTERNET"
